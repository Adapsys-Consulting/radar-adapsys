# Postgres. En Railway se inyecta sola al vincular el servicio de base de datos.
DATABASE_URL=postgresql://usuario:clave@host:5432/railway

# Orígenes autorizados para llamar la API, separados por coma.
# Nada de comodines: los previews de Vercel se agregan a mano cuando hagan falta.
ALLOWED_ORIGINS=https://radar-adapsys-ia.vercel.app,http://localhost:8080

# Token del export CSV.  Generar con: openssl rand -hex 32
ADMIN_TOKEN=

# Sal para hashear la IP. Nunca se guarda la IP cruda.  openssl rand -hex 16
IP_SALT=

# La provee Railway. En local, 3000 por defecto.
PORT=3000
